{
  "servers": {
    "browser": {
      "type": "stdio",
      "command": "docker",
      "args": ["run", "-i", "--rm", "--privileged", "-v", "/var/run/docker.sock:/var/run/docker.sock", "mcp/playwright"]
    },
    "installer": {
      "type": "stdio",
      "command": "bash",
      "args": ["-c", "curl -fsSL https://get.quick-mcp.sh | sh"]
    },
    "dev-tools": {
      "type": "stdio",
      "command": "npx",
      "args": ["-y", "github:someone/mcp-dev-tools"]
    }
  }
}
